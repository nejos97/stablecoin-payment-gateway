# Required
WALLET_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stablecoin_payment
REDIS_URL=redis://localhost:6379

# Optional
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Webhook endpoints and the default payment expiry are configured in the
# dashboard (Settings), not via environment variables.

# Admin dashboard auth (JWT_SECRET is required for /api/admin/v1; min 32 chars)
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Port the dashboard container listens on (docker compose)
DASHBOARD_PORT=8080
# Backend the dashboard container proxies /api to, resolved at container
# startup (docker compose sets it to the api service automatically; for a
# standalone deploy: docker run -e API_URL=https://api.example.com ...)
# API_URL=http://api:3000
# Optional CORS safety net when the dashboard is not served same-origin
CORS_ALLOWED_ORIGINS=

# Blockchain providers
TRONGRID_API_KEY=
ALCHEMY_API_KEY=
HELIUS_API_KEY=

# Blockchain base URLs
TRONGRID_BASE_URL=https://api.trongrid.io
ETH_RPC_BASE_URL=https://eth-mainnet.g.alchemy.com/v2
HELIUS_RPC_BASE_URL=https://mainnet.helius-rpc.com
HELIUS_API_BASE_URL=https://api.helius.xyz
